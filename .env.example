# Локальный запуск: скопируй в .env и заполни нужные значения.
# conftest.py читает .env через python-dotenv; любую переменную можно
# переопределить в shell: BASE_URL=... pytest

# --- Стенд ---------------------------------------------------------------
BASE_URL=https://niffler.qa.guru
AUTH_URL=https://auth.niffler.qa.guru

# --- Браузер -------------------------------------------------------------
# chrome | firefox   (приоритет у CLI-флага: pytest --browser=firefox)
BROWSER=chrome
# Метка версии браузера (capability browserVersion; в remote-режиме —
# версия браузера на Selenoid-ноде). Пусто = дефолт.
BROWSER_VERSION=
# true = headless; false = открытое окно браузера
HEADLESS=true

# --- Remote Grid / Selenoid (опционально) --------------------------------
# Если задан — тесты идут на remote-драйвер вместо локального.
# Для selenoid.qa.guru URL с basic-auth: https://user:token@selenoid.qa.guru/wd/hub
# Креды сюда не коммитить — .env в .gitignore.
SELENIUM_REMOTE_URL=
# Явный запрос remote-режима: если true, а URL пуст — тесты упадут с
# понятной ошибкой (защита от "забыл задать URL").
SELENIUM_REMOTE=false

# --- Telegram-уведомления (для notify_telegram.py; опционально) ----------
# Без них скрипт напечатает skip и завершится нулём.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
